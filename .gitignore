# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — 공유 설정(settings.json)만 추적, 개인 설정(settings.local.json 등)은 무시
.claude/*
!.claude/settings.json

# 로컬 검증용 임시 데이터
*.local.json
*.local.mts
.htmlcheck/

# 스크린샷 러너 산출물 (tests/e2e)
# 사진·PDF는 저장소에 넣지 않는다. 매 실행마다 통째로 바뀌는 바이너리라
# 디프가 무의미하고 저장소만 무거워진다.
# docs/qa/console-errors.md는 텍스트 보고서라 커밋한다 — 러너를 돌리지 않는
# 사람도 마지막 실행에서 무엇이 나왔는지 읽을 수 있어야 한다.
/docs/qa/shots/
/docs/qa/pdf/
# /admin 수동 캡처. 러너에 넣지 않는다 — 토큰이 URL 에 실리므로
# 커밋되는 산출물에 경로가 남을 자리를 아예 만들지 않는다. (tests/e2e/_shared.mts 주석)
/docs/qa/admin/
# v2 흐름 E2E (tests/e2e/v2-flow.mts) — 실패 사진·픽스처 PDF는 넣지 않고 report.md만 커밋한다
/docs/qa/e2e-v2/*.png
/docs/qa/e2e-v2/*.pdf
/docs/qa/e2e-v2/*.txt
