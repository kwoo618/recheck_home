# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Gemini API — 서버에서만 사용 (NEXT_PUBLIC_ 접두사 절대 금지)
GEMINI_API_KEY=""

# 카카오맵 JS SDK — 클라이언트 노출되므로 반드시 도메인 제한 설정
# localhost 와 Vercel 배포 도메인 둘 다 등록할 것
NEXT_PUBLIC_KAKAO_MAP_KEY=""

# 카카오 REST 키 (주소→좌표 변환 서버 프록시용) — 서버 전용
KAKAO_REST_KEY=""
