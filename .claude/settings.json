      "Edit(./.env.*)",

      "Edit(./drizzle/**)",

      "Edit(./screenshots/v1-baseline/**)",

      "Edit(./docs/v1/**)",
      "Edit(./docs/PORTFOLIO-NOTES.md)",

      "Bash(vercel:*)",
