{
  "name": "recheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:watch": "vitest",
    "qa:seed": "node --import ./tests/e2e/_register-alias.mts --conditions=react-server --env-file=.env.local tests/e2e/seed.mts",
    "qa:clean": "node --import ./tests/e2e/_register-alias.mts --conditions=react-server --env-file=.env.local tests/e2e/seed.mts --clean",
    "icon:gen": "node tests/e2e/gen-icon.mts",
    "qa:demo": "node --import ./tests/e2e/_register-alias.mts --conditions=react-server --env-file=.env.local tests/e2e/seed-demo.mts",
    "qa:demo:clean": "node --import ./tests/e2e/_register-alias.mts --conditions=react-server --env-file=.env.local tests/e2e/seed-demo.mts --clean",
    "qa:shoot": "node --import ./tests/e2e/_register-alias.mts --env-file=.env.local tests/e2e/shoot.mts",
    "shots": "npm run qa:shoot",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
